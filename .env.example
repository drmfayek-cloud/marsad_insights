# Copy to insights.env (Docker) or enter these in your host's environment settings. Keep the filled file private.
MARSAD_DATA=/data
MARSAD_HTTPS=1                 # 1 when served over HTTPS (always in production)
MARSAD_REQUIRE_MFA=1           # authenticator-app code at every sign-in
MARSAD_SESSION_HOURS=8
MARSAD_DEMO=0                  # 1 = synthetic demo data and demo accounts (never with real data)
# First administrator, created only when the user table is empty. Change the password at first sign-in,
# then remove MARSAD_ADMIN_PASSWORD from the environment.
MARSAD_ADMIN_EMAIL=
MARSAD_ADMIN_NAME=
MARSAD_ADMIN_PASSWORD=
# Optional: supply from a secret manager. If blank, keys are generated once in MARSAD_DATA and must be backed up with it.
MARSAD_SECRET_KEY=
MARSAD_HASH_KEY=
